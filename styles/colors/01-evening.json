{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"title": "Evening",
	"settings": {
		"color": {
			"palette": [
				{
					"color": "#1B1B1B",
					"name": "Surface-Bg",
					"slug": "surface-bg"
				},
				{
					"color": "#F0F0F0",
					"name": "Contrast",
					"slug": "text-primary"
				},
				{
					"color": "#786D0A",
					"name": "Accent 1",
					"slug": "accent-1"
				},
				{
					"color": "#442369",
					"name": "Accent 2",
					"slug": "accent-2"
				},
				{
					"color": "#D1D0EA",
					"name": "Azure-Web",
					"slug": "azure-web"
				},
				{
					"color": "#CBCBCB",
					"name": "Brand-Blue",
					"slug": "brand-blue"
				},
				{
					"color": "#353535",
					"name": "Accent 5",
					"slug": "accent-5"
				},
				{
					"color": "#FFFFFF33",
					"name": "Accent 6",
					"slug": "accent-6"
				}
			]
		}
	},
	"styles": {
		"color": {
			"text": "var:preset|color|brand-blue"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var:preset|color|text-primary",
					"text": "var:preset|color|surface-bg"
				},
				":hover": {
					"color": {
						"background": "color-mix(in srgb, var(--wp--preset--color--text-primary) 85%, transparent)",
						"text": "var:preset|color|surface-bg"
					}
				}
			}
		},
		"variations": {
			"section-2": {
				"elements": {
					"button": {
						"color": {
							"background": "var:preset|color|surface-bg",
							"text": "var:preset|color|text-primary"
						},
						":hover": {
							"color": {
								"background": "color-mix(in srgb, var(--wp--preset--color--surface-bg) 85%, transparent)"
							}
						}
					}
				}
			},
			"section-4": {
				"elements": {
					"button": {
						"color": {
							"background": "var:preset|color|azure-web",
							"text": "var:preset|color|text-primary"
						},
						":hover": {
							"color": {
								"background": "color-mix(in srgb, var(--wp--preset--color--azure-web) 85%, transparent)"
							}
						}
					}
				}
			}
		}
	}
}
